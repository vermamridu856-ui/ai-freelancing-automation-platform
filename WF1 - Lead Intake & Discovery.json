      "name": "Normalize Lead Data"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Input: expects client_email and project_title on the current item\nconst email = ($input.item.json.client_email || '').toLowerCase().trim();\nconst title = ($input.item.json.project_title || '').toLowerCase().trim();\n\nconst raw = `${email}|${title}`;\n\n// Simple deterministic hash (no external crypto libs needed)\nlet hash = 0;\nfor (let i = 0; i < raw.length; i++) {\n  const char = raw.charCodeAt(i);\n  hash = (hash << 5) - hash + char;\n  hash |= 0; // convert to 32-bit integer\n}\n\nreturn {\n  ...$input.item.json,\n  dedupe_hash: `LEAD-${Math.abs(hash)}`\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        64
      ],
      "id": "caa2d38e-7ae6-481e-a5c7-26099d67584c",
      "name": "Compute Dedupe Hash"
