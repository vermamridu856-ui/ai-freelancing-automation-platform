      "name": "Get Project Milestones"
    },
    {
      "parameters": {
        "jsCode": "// Groups milestones by project_id, checks if every one is \"completed\"\nconst items = $input.all();\n\n// Group milestones by project_id\nconst grouped = {};\nfor (const item of items) {\n  const pid = item.json.project_id;\n  if (!grouped[pid]) grouped[pid] = [];\n  grouped[pid].push(item.json);\n}\n\nconst results = [];\nfor (const projectId in grouped) {\n  const milestones = grouped[projectId];\n  const allComplete = milestones.every(m => m.status === 'completed');\n  if (allComplete) {\n    results.push({ json: { project_id: Number(projectId) } });\n  }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
