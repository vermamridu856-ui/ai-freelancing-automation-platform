    {
      "parameters": {
        "jsCode": "const leads = $('Get All Leads for Analytics').all().map(i => i.json);\nconst projects = $('Get All Projects for Analytics').all().map(i => i.json);\nconst invoices = $input.all().map(i => i.json); // this node's direct input = invoices\n\nconst totalLeads = leads.length;\nconst wonLeads = leads.filter(l => l.status === 'proposal_sent' || l.status === 'meeting_scheduled').length;\nconst conversionRate = totalLeads > 0 ? ((wonLeads / totalLeads) * 100).toFixed(1) + '%' : '0%';\n\nconst totalRevenue = invoices\n  .filter(inv => inv.status === 'paid')\n  .reduce((sum, inv) => sum + (Number(inv.amount) || 0), 0);\n\nconst closedProjects = projects.filter(p => p.status === 'closed').length;\nconst activeProjects = projects.filter(p => p.status === 'active').length;\n\nreturn [{\n  json: {\n    total_leads: totalLeads,\n    lead_conversion_rate: conversionRate,\n    total_revenue_collected: totalRevenue,\n    active_projects: activeProjects,\n    closed_projects: closedProjects,\n    computed_at: new Date().toISOString()\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
